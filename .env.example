# Coze Workflow Token（调用 WF-1 所需）
COZE_TOKEN=<your_coze_token>
COZE_TOKEN_WF2=<your_wf2_coze_token>
COZE_TOKEN_WF3=<your_wf3_coze_token>

# Coze Coding 数据库（创建数据库后由平台注入；未配置时本地使用服务端内存存储）
PGDATABASE_URL=<your_postgresql_url>

# 中期手机号修改固定验证码，公开部署前请替换为真实短信验证
TEST_SMS_CODE=123456

# Coze Sandbox Object Storage
# 云端 Coze Coding 会自动注入；
# 本地调试需要配置对应环境变量

COZE_BUCKET_ENDPOINT_URL=<your_bucket_endpoint_url>
COZE_BUCKET_NAME=<your_bucket_name>

# Workload Identity 认证
# 云端 Coze Coding 会自动注入；
# 本地调试需要配置对应凭证

COZE_WORKLOAD_IDENTITY_CLIENT_ID=<your_client_id>
COZE_WORKLOAD_IDENTITY_CLIENT_SECRET=<your_client_secret>
COZE_WORKLOAD_IDENTITY_TOKEN_ENDPOINT=https://api.coze.cn/.well-known/token

COZE_INTEGRATION_BASE_URL=https://integration.coze.cn

COZE_WORKLOAD_IDENTITY_API_KEY=<your_workload_identity_api_key>
