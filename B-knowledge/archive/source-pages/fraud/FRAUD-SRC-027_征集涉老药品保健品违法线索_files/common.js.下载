/*设置修饰线*/
function setEmline(){
  $('.set-emline .hd').each(function() {
	$(this).find('i').css({
	  width: ($(this).width() - $(this).find('a').outerWidth()) / 2
	});
	$(this).find('.hr').css({
	  width: ($(this).width() - $(this).find('a').outerWidth())
	});
  });
}

