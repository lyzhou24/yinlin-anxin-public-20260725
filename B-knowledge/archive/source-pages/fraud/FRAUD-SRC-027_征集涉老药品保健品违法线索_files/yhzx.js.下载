function replaceStart (str,frontLen,endLen){
	// str：字符串，frontLen：前面保留位数，endLen：后面保留位数。
	var len = str.length-frontLen-endLen;
	var start = '';
	for (var i=0;i<len;i++) {
	  start+='*';
	}
	return str.substring(0,frontLen)+start+str.substring(str.length-endLen);
}
function userdata(){
    var _data={
