        dataType: "json",
        contentType: "application/json",
        beforeSend: function(xhr) { 
            xhr.setRequestHeader("Authorization","Bearer "+usertoke);  
        },
        success: function (response) {
			// 核心优化1：多层级有效性校验，确保response、custom、displayname存在且有效
            var isValidUser = response && 
                              response.custom && 
                              (response.custom.displayname || response.custom.agentname); // 兼容个人/代理两种用户类型
            
            if (!isValidUser) {
                // 核心优化2：用户信息无效，清除access_token（两种删除方法确保清理干净）
                delCookie('access_token');
                delCookieall('access_token');
