}
function importantCss(path){
	document.write("<link type='text/css' rel='stylesheet' href='/front/ui/" + path + "'/>"); 
}
function getQueryString(name, url) {
	if(url == undefined){
		url = window.location.search.substr(1);
	}else if(url.indexOf("?") != -1){
		url = url.substr(url.indexOf("?") + 1)
	}else{
		url = "";
	}
	var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i"); 
	var r = url.match(reg); 
	if (r != null){
		return decodeURI(r[2]);
	}
	return ""; 
}

function post(url, setting){
	var opt = {
			type:'json',
			contentType : 'application/x-www-form-urlencoded',
			error:function(a,b,msg){alert('操作失败');},
			success:function(){},
			data:null,
			async:false
	};
	opt = $.extend(opt, setting);
	url = appUrl + url;
	//定义一个新的，防止引引用问题被修改
	var data = {};
	if(opt.data != null){
		$.base64.utf8encode = true;
		for (key in opt.data){
			var value = $.base64.btoa(opt.data[key] + "");	
			data[key] = value;
		}
	}
	$.ajax({
		type: "post",
		url: url,
		dataType: opt.type,
		error : opt.error,
		contentType : opt.contentType,
		data:data,
		success : opt.success,
		async:opt.async
	});
}
