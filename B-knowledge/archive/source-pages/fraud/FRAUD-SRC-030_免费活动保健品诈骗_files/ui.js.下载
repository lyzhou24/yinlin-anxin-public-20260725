Array.prototype.contains = function(needle) {
	for (i in this) {
		if (this[i] == needle){
			return true;
		}
	}
	return false;
}
String.prototype.replaceAll = function(s1,s2){ 
	return this.replace(new RegExp(s1,"gm"),s2); 
}


