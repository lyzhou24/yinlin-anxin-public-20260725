	// var userName = $('input.userName').val().trim();
	// var passWord = $('input.passWord').val().trim();
	$.ajax({
		type : "post",
		async : false,
		url :  "/dologin",
		datatype : "json",
		data : {
			"reqUrl" : reqUrl
		},
		success : function(data) {
			if (data.code == 0) {
				$.ajax({
					type : "post",
					async : false,
					url : "/user/getUserName",
					datatype : "json",
					data : {},
					success : function(data) {
						if (data.code == "1") {
							$(".wdl").attr("style", "display:none");
							$(".ydl").attr("style", "");
							$("#user").text(data.result);
						}
					}
				})
				// location.href = "/getUserName";
				// location.href = data.loginUrl;
			} else {
				alert(data.msg);
			}
		}
	})

}

// 注册
function register() {
	// 注册跳转到总局页面
	$.ajax({
		type : "post",
		url : $ctx + "/register",
		datatype : "json",
		async : false,
		cache : false,
		data : {},
		success : function(data) {
			if (data.code == 0) {
				location.href = data.regUrl;
			} else {
				alert(data.msg);
			}
		}
	});
}

// 获取邮箱验证码
function getCode(type) {
	// 用户名
	var r_username = $("#r_username").val().trim();
	if (r_username == "" || r_username == null) {
		alert("请输入用户名");
		return false;
	} else if (!emailRegex.test(r_username)) {
		alert("邮箱格式不正确");
		return false;
	} else {
		$.ajax({
			type : "post",
			url : "/getCode",
			datatype : "json",
			async : false,
			cache : false,
			data : {
				"username" : r_username,
				'type' : type
			},
			success : function(data) {
				alert(data.code);
			}
		});
	}
}