    function getRelDoc(relArgs) {
        var docsids = [];
        var docs = jQuery(relArgs.selecter || ".wj-a");
        docs.each(function(i) {
            docsids.push(~~this.id.replace(relArgs.idPre || "rel_", ""));
        });
