						url="http://www.people.cn/app/download.html"
					}
				}else if(isHarmony){
					url = 'https://appgallery.huawei.com/app/detail?id=cn.people.plus.hm'
				}else{
				    if(isWx){
						that.showCoverDom();
					}else if(isWeiBo||isQQ){
						url="https://apps.apple.com/us/app/人民网/id1542555380"
					}else{
						url="http://www.people.cn/app/download.html"
					}
				}
				window.location.href = url
			}
		}, times);
	}
