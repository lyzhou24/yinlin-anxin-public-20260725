			listTitle, 
			pushDate, 
			source, 
			likes, 
			imageUrl, 
			articleId, 
			type, 
			sysCode,
			pageStyle 
		} = this.article;
		
		const obj = {
			listTitle, 
			pushDate, 
			source, 
			likes, 
			imageUrl, 
			articleId: articleId,
			type: type,
			sysCode: sysCode,
			pageStyle
		}
