			if (videoList.length == 1 && isAndroid) {
			    videoList.forEach((video, index) => {
					let currentVideo = video.currentSrc;
					window.appapi.appPostMessage('videoControl',JSON.stringify({
						videoUrl:currentVideo,
						eventKey:'play'
					}))
				});
			}
		}
	}
})();